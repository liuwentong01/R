# 默认使用 mock provider，无需 API Key，适合本地学习和验证 TypeScript demo。
LANGCHAIN_DEMO_PROVIDER=mock

# 使用真实 DeepSeek 模型时改为 deepseek，并填入 DEEPSEEK_API_KEY。
# LANGCHAIN_DEMO_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# LANGCHAIN_DEMO_MODEL=deepseek-v4-flash

# DeepSeek OpenAI-compatible API 地址，通常不需要修改。
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型温度，越低越稳定。
LANGCHAIN_DEMO_TEMPERATURE=0

# 真实模型请求超时时间，避免网络异常时 demo 长时间卡住。
LANGCHAIN_DEMO_TIMEOUT_MS=20000
